# gerado pelo cais a partir de /etc/cais/config.yaml -- nao edite aqui,
# o proximo Setup sobrescreve
name: infra

services:
  postgres:
    image: postgres:18-alpine
    container_name: infra-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: postgres
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    secrets:
      - postgres_password
    volumes:
      - infra_postgres_data:/var/lib/postgresql
    networks:
      - infra_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  mysql:
    image: mysql:9.7
    container_name: infra-mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: app
      MYSQL_USER: app
      MYSQL_ROOT_PASSWORD_FILE: /run/secrets/mysql_root_password
      MYSQL_PASSWORD_FILE: /run/secrets/mysql_password
    secrets:
      - mysql_root_password
      - mysql_password
    volumes:
      - infra_mysql_data:/var/lib/mysql
    networks:
      - infra_network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  infra_network:
    name: infra_network
    driver: bridge

volumes:
  infra_postgres_data:
    name: infra_postgres_data
  infra_mysql_data:
    name: infra_mysql_data

secrets:
  postgres_password:
    file: "{{secret "postgres_password"}}"
  mysql_root_password:
    file: "{{secret "mysql_root_password"}}"
  mysql_password:
    file: "{{secret "mysql_password"}}"
