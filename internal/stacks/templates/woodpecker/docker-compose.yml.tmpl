# gerado pelo cais a partir de /etc/cais/config.yaml -- nao edite aqui,
# o proximo Setup sobrescreve
name: woodpecker

services:
  woodpecker-server:
    image: woodpeckerci/woodpecker-server:v3.17.0
    container_name: woodpecker-server
    restart: unless-stopped
    environment:
      WOODPECKER_OPEN: "false"
      WOODPECKER_HOST: "https://{{.CIHost}}"
      WOODPECKER_GITHUB: "true"
      WOODPECKER_GITHUB_CLIENT: "{{.GitHubClient}}"
      WOODPECKER_GITHUB_CLIENT_SECRET_FILE: /run/secrets/github_client_secret
      WOODPECKER_ADMIN: "{{.Admin}}"
      WOODPECKER_AGENT_SECRET_FILE: /run/secrets/agent_secret
    labels:
      bunkerweb.SERVER_NAME: "{{.CIHost}}"
      bunkerweb.USE_REVERSE_PROXY: "yes"
      bunkerweb.REVERSE_PROXY_URL: "/"
      bunkerweb.REVERSE_PROXY_HOST: "http://woodpecker-server:8000"
      bunkerweb.AUTO_LETS_ENCRYPT: "yes"
    secrets:
      - github_client_secret
      - agent_secret
    volumes:
      - woodpecker_server_data:/var/lib/woodpecker
    networks:
      - proxy_network
      - woodpecker_network

  woodpecker-agent:
    image: woodpeckerci/woodpecker-agent:v3.17.0
    container_name: woodpecker-agent
    restart: unless-stopped
    command: agent
    environment:
      WOODPECKER_SERVER: woodpecker-server:9000
      WOODPECKER_AGENT_SECRET_FILE: /run/secrets/agent_secret
      WOODPECKER_MAX_WORKFLOWS: "2"
      # anexa os containers de cada step nessa rede tambem, pra alcancarem
      # o registry interno (registry:5000) durante build/push
      WOODPECKER_BACKEND_DOCKER_NETWORK: infra_network
      DOCKER_HOST: tcp://woodpecker-docker-proxy:2375
    secrets:
      - agent_secret
    networks:
      - woodpecker_network
      - woodpecker_docker_proxy_network
    depends_on:
      - woodpecker-server
      - woodpecker-docker-proxy

  woodpecker-docker-proxy:
    image: tecnativa/docker-socket-proxy:v0.5.0
    container_name: woodpecker-docker-proxy
    restart: unless-stopped
    environment:
      # o agent precisa mesmo criar/rodar container pra cada step
      CONTAINERS: 1
      IMAGES: 1
      NETWORKS: 1
      VOLUMES: 1
      BUILD: 1
      POST: 1
      # tudo que da acesso a OUTROS containers/ao host fica bloqueado
      EXEC: 0
      SYSTEM: 0
      SWARM: 0
      SECRETS: 0
      NODES: 0
      SERVICES: 0
      TASKS: 0
      CONFIGS: 0
      PLUGINS: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - woodpecker_docker_proxy_network

networks:
  proxy_network:
    external: true
    name: proxy_network
  woodpecker_network:
    name: woodpecker_network
    driver: bridge
    internal: true
  woodpecker_docker_proxy_network:
    name: woodpecker_docker_proxy_network
    driver: bridge
    internal: true

volumes:
  woodpecker_server_data:
    name: woodpecker_server_data

secrets:
  agent_secret:
    file: "{{secret "agent_secret"}}"
  github_client_secret:
    file: "{{secret "github_client_secret"}}"
