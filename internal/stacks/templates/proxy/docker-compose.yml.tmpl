# gerado pelo cais a partir de /etc/cais/config.yaml -- nao edite aqui,
# o proximo Setup sobrescreve
name: proxy

# Traefik como reverse proxy. O proxy nasce vazio: cada servico que quer ser
# publicado entra na proxy_network e se anuncia por labels (traefik.enable,
# traefik.http.routers.<nome>.rule...); o Traefik le os labels pelo docker e
# configura sozinho ao ver o container subir.

services:
  traefik:
    image: traefik:v3.7.16
    container_name: proxy-traefik
    restart: unless-stopped
    # sem limite o log do docker cresce ate encher o disco
    logging:
      driver: json-file
      options: {max-size: "20m", max-file: "5"}
    command:
      # so publica container com traefik.enable=true (o padrao publica todos)
      - --providers.docker.exposedbydefault=false
      - --providers.docker.endpoint=tcp://traefik-docker-proxy:2375
      - --providers.docker.network=proxy_network
      - --entrypoints.web.address=:80
{{- if eq .HTTPSPort 443}}
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
{{- else}}
      # HTTPS publicado fora da 443 (teste ou migracao): o redirecionamento
      # leva pra porta de fora (o "websecure" levaria pra 443, onde nao ha nada)
      - --entrypoints.web.http.redirections.entrypoint.to=:{{.HTTPSPort}}
{{- end}}
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.address=:443
      - --entrypoints.websecure.http.tls=true
{{- if .BehindProxy}}
      # atras de outro proxy da VPS (migracao): ele e quem fala com a
      # internet, entao vale o X-Forwarded-For dele. Sem HTTP/3: o Alt-Svc
      # chamaria o navegador pro UDP de uma porta que so escuta no loopback
      - --entrypoints.web.forwardedheaders.trustedips={{.TrustedIPs}}
      - --entrypoints.websecure.forwardedheaders.trustedips={{.TrustedIPs}}
{{- else}}
      - --entrypoints.websecure.http3=true
{{- end}}
      - --entrypoints.websecure.http.middlewares=cais-headers@file
      # o padrao de 60s corta upload grande (arquivos, S3)
      - --entrypoints.websecure.transport.respondingtimeouts.readtimeout=30m
{{- if .LetsEncrypt}}
      - --entrypoints.websecure.http.tls.certresolver=le
      - --certificatesresolvers.le.acme.email={{.Email}}
      - --certificatesresolvers.le.acme.storage=/letsencrypt/acme.json
{{- if .DNS}}
      # prova pelo DNS: o Traefik cria um registro TXT com o token da API da
      # Cloudflare (CF_DNS_API_TOKEN_FILE, abaixo). O Let's Encrypt nao acessa a
      # VPS, entao serve pra dominio que a internet nao alcanca (Tailscale)
      - --certificatesresolvers.le.acme.dnschallenge.provider=cloudflare
      - --certificatesresolvers.le.acme.dnschallenge.resolvers=1.1.1.1:53,1.0.0.1:53
{{- range $i, $d := .Wildcards}}
      # curinga: um certificado pra {{$d}} e *.{{$d}}; os apps debaixo dele
      # usam este e nao pedem outro
      - --entrypoints.websecure.http.tls.domains[{{$i}}].main={{$d}}
      - --entrypoints.websecure.http.tls.domains[{{$i}}].sans=*.{{$d}}
{{- end}}
{{- else}}
      - --certificatesresolvers.le.acme.httpchallenge.entrypoint=web
{{- end}}
{{- end}}
      # config fixa do proxy (os headers; no selfsigned, o certificado
      # padrao): arquivos do compose, nao labels. Label no proprio Traefik
      # pediria traefik.enable, e ele se publicaria com a regra padrao
      # Host(`traefik-proxy`), pedindo certificado pra esse nome sem fim
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=false
      - --ping=true
      # API so no loopback do container (sem porta publicada; os apps na
      # proxy_network nao alcancam): o deploy sem queda do cais pergunta por
      # docker exec quais containers o Traefik usa antes de parar o antigo
      - --api.insecure=true
      - --entrypoints.traefik.address=127.0.0.1:8080
      # contadores de requisicoes (dashboard do cais), no mesmo endereco da
      # API: so o loopback do container, lido por docker exec
      - --metrics.prometheus=true
      - --metrics.prometheus.entrypoint=traefik
      - --metrics.prometheus.addentrypointslabels=true
      - --metrics.prometheus.addserviceslabels=true
      - --accesslog=true
      - --global.checknewversion=false
      - --global.sendanonymoususage=false
    ports:
{{- if .BehindProxy}}
      # so no loopback: chega aqui so o proxy da frente, nesta VPS
      - "127.0.0.1:{{.HTTPPort}}:80"
      - "127.0.0.1:{{.HTTPSPort}}:443"
{{- else}}
      - "{{.HTTPPort}}:80"
      - "{{.HTTPSPort}}:443"
      - "{{.HTTPSPort}}:443/udp"
{{- end}}
    configs:
      - source: traefik_headers
        target: /etc/traefik/dynamic/headers.yml
{{- if not .LetsEncrypt}}
      - source: traefik_tls
        target: /etc/traefik/dynamic/tls.yml
{{- end}}
{{- if .LetsEncrypt}}
    volumes:
      - traefik_acme:/letsencrypt
{{- if .DNS}}
    # o token chega por arquivo (o lego le o _FILE): nao fica no docker inspect
    environment:
      CF_DNS_API_TOKEN_FILE: /run/secrets/cloudflare_dns_token
    secrets:
      - cloudflare_dns_token
{{- end}}
{{- else}}
    secrets:
      - tls_cert
      - tls_key
{{- end}}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - proxy_network
      - traefik-docker-proxy-network
    depends_on:
      - traefik-docker-proxy

  # unico lugar que toca o docker.sock de verdade. O Traefik so precisa
  # OBSERVAR containers/labels (nunca criar/executar nada), entao fica so
  # leitura -- POST: 0 bloqueia qualquer escrita independente das outras flags.
  traefik-docker-proxy:
    image: tecnativa/docker-socket-proxy:v0.5.0
    container_name: proxy-docker-proxy
    restart: unless-stopped
    # sem limite o log do docker cresce ate encher o disco
    logging:
      driver: json-file
      options: {max-size: "20m", max-file: "5"}
    environment:
      CONTAINERS: 1
      NETWORKS: 1
      POST: 0
      EXEC: 0
      SYSTEM: 0
      SWARM: 0
      SECRETS: 0
      NODES: 0
      SERVICES: 0
      TASKS: 0
      CONFIGS: 0
      PLUGINS: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - traefik-docker-proxy-network

networks:
  proxy_network:
    name: proxy_network
    driver: bridge
  traefik-docker-proxy-network:
    name: traefik-docker-proxy-network
    driver: bridge
    internal: true

configs:
  # headers aplicados em todo site (middleware do entrypoint websecure).
  # HSTS sem includeSubDomains: nao forca HTTPS em nome que o cais nao
  # controla
  traefik_headers:
    content: |
      http:
        middlewares:
          cais-headers:
            headers:
              stsSeconds: 31536000
              contentTypeNosniff: true
              referrerPolicy: strict-origin-when-cross-origin
{{- if not .LetsEncrypt}}
  traefik_tls:
    content: |
      tls:
        stores:
          default:
            defaultCertificate:
              certFile: /run/secrets/tls_cert
              keyFile: /run/secrets/tls_key
{{- end}}
{{- if .LetsEncrypt}}

volumes:
  traefik_acme:
    name: traefik_acme
{{- if .DNS}}

secrets:
  cloudflare_dns_token:
    file: "{{secret "cloudflare_dns_token"}}"
{{- end}}
{{- else}}

secrets:
  tls_cert:
    file: "{{secret "tls_cert"}}"
  tls_key:
    file: "{{secret "tls_key"}}"
{{- end}}
