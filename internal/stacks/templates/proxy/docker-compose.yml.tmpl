# gerado pelo cais a partir de /etc/cais/config.yaml -- nao edite aqui,
# o proximo Setup sobrescreve
name: proxy

# Traefik como reverse proxy. O proxy nasce vazio: cada servico que quer ser
# publicado entra na proxy_network e se anuncia por labels (traefik.enable,
# traefik.http.routers.<nome>.rule...); o Traefik le os labels pelo docker e
# configura sozinho ao ver o container subir.

services:
  traefik:
    image: traefik:v3.7.16
    container_name: proxy-traefik
    restart: unless-stopped
    command:
      # so publica container com traefik.enable=true (o padrao publica todos)
      - --providers.docker.exposedbydefault=false
      - --providers.docker.endpoint=tcp://traefik-docker-proxy:2375
      - --providers.docker.network=proxy_network
      - --entrypoints.web.address=:80
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.address=:443
      - --entrypoints.websecure.http.tls=true
      - --entrypoints.websecure.http3=true
      - --entrypoints.websecure.http.middlewares=cais-headers@docker
      # o padrao de 60s corta o push de uma camada grande no registry
      - --entrypoints.websecure.transport.respondingtimeouts.readtimeout=30m
{{- if .LetsEncrypt}}
      - --entrypoints.websecure.http.tls.certresolver=le
      - --certificatesresolvers.le.acme.email={{.Email}}
      - --certificatesresolvers.le.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.le.acme.httpchallenge.entrypoint=web
{{- else}}
      # tls: selfsigned -- certificado da CA local do cais como padrao
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=false
{{- end}}
      - --ping=true
      - --accesslog=true
      - --global.checknewversion=false
      - --global.sendanonymoususage=false
    ports:
      - "{{.HTTPPort}}:80"
      - "{{.HTTPSPort}}:443"
      - "{{.HTTPSPort}}:443/udp"
    labels:
      # headers aplicados em todo site (middleware do entrypoint websecure).
      # HSTS sem includeSubDomains: nao forca HTTPS em nome que o cais nao
      # controla
      traefik.enable: "true"
      traefik.http.middlewares.cais-headers.headers.stsSeconds: "31536000"
      traefik.http.middlewares.cais-headers.headers.contentTypeNosniff: "true"
      traefik.http.middlewares.cais-headers.headers.referrerPolicy: "strict-origin-when-cross-origin"
{{- if .LetsEncrypt}}
    volumes:
      - traefik_acme:/letsencrypt
{{- else}}
    configs:
      - source: traefik_tls
        target: /etc/traefik/dynamic/tls.yml
    secrets:
      - tls_cert
      - tls_key
{{- end}}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - proxy_network
      - traefik-docker-proxy-network
    depends_on:
      - traefik-docker-proxy

  # unico lugar que toca o docker.sock de verdade. O Traefik so precisa
  # OBSERVAR containers/labels (nunca criar/executar nada), entao fica so
  # leitura -- POST: 0 bloqueia qualquer escrita independente das outras flags.
  traefik-docker-proxy:
    image: tecnativa/docker-socket-proxy:v0.5.0
    container_name: proxy-docker-proxy
    restart: unless-stopped
    environment:
      CONTAINERS: 1
      NETWORKS: 1
      POST: 0
      EXEC: 0
      SYSTEM: 0
      SWARM: 0
      SECRETS: 0
      NODES: 0
      SERVICES: 0
      TASKS: 0
      CONFIGS: 0
      PLUGINS: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - traefik-docker-proxy-network

networks:
  proxy_network:
    name: proxy_network
    driver: bridge
  traefik-docker-proxy-network:
    name: traefik-docker-proxy-network
    driver: bridge
    internal: true
{{- if .LetsEncrypt}}

volumes:
  traefik_acme:
    name: traefik_acme
{{- else}}

configs:
  traefik_tls:
    content: |
      tls:
        stores:
          default:
            defaultCertificate:
              certFile: /run/secrets/tls_cert
              keyFile: /run/secrets/tls_key

secrets:
  tls_cert:
    file: "{{secret "tls_cert"}}"
  tls_key:
    file: "{{secret "tls_key"}}"
{{- end}}
