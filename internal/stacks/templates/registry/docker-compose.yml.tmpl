# gerado pelo cais a partir de /etc/cais/config.yaml -- nao edite aqui,
# o proximo Setup sobrescreve
name: registry

# Registry de imagens publicado pelo Traefik em https://{{.RegistryHost}},
# com TLS e login (htpasswd). O Traefik nao limita o tamanho do corpo e
# repassa o upload em stream; o timeout de leitura do entrypoint e o unico
# ajuste que o push de camadas grandes precisa (na stack proxy).
#
# O CI faz push e a VPS faz pull pelo mesmo nome, sem insecure-registries no
# dockerd. Fica numa stack propria pra so ele entrar na proxy_network, nunca
# os bancos da infra.

services:
  registry:
    image: registry:3.1.1
    container_name: registry
    restart: unless-stopped
    environment:
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: "Registry"
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
      # atras do proxy: Location relativo, sem depender do Host/porta interna
      REGISTRY_HTTP_RELATIVEURLS: "true"
      # ja e o padrao, mas fica explicito: uma senha vazada publica imagem,
      # mas nao apaga o historico pela API
      REGISTRY_STORAGE_DELETE_ENABLED: "false"
    secrets:
      - source: registry_htpasswd
        target: /auth/htpasswd
    labels:
      traefik.enable: "true"
      traefik.http.routers.registry.rule: "Host(`{{.RegistryHost}}`)"
      traefik.http.routers.registry.entrypoints: websecure
      traefik.http.services.registry.loadbalancer.server.port: "5000"
    volumes:
      - registry_data:/var/lib/registry
    networks:
      - proxy_network
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:5000/"]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  proxy_network:
    external: true
    name: proxy_network

volumes:
  registry_data:
    name: registry_data

secrets:
  registry_htpasswd:
    file: "{{secret "registry_htpasswd"}}"
