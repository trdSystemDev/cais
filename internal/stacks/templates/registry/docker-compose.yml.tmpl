# gerado pelo cais a partir de /etc/cais/config.yaml -- nao edite aqui,
# o proximo Setup sobrescreve
name: registry

# Registry de imagens publicado pelo BunkerWeb em https://{{.RegistryHost}},
# com TLS do Let's Encrypt e login (htpasswd). O CI faz push e a VPS faz
# pull pelo mesmo nome, sem insecure-registries no dockerd. Fica numa stack
# propria pra so ele entrar na proxy_network, nunca os bancos da infra.

services:
  registry:
    image: registry:3.1.1
    container_name: registry
    restart: unless-stopped
    environment:
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: "Registry"
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
      # atras do proxy: Location relativo, sem depender do Host/porta interna
      REGISTRY_HTTP_RELATIVEURLS: "true"
    secrets:
      - source: registry_htpasswd
        target: /auth/htpasswd
    labels:
      bunkerweb.SERVER_NAME: "{{.RegistryHost}}"
      bunkerweb.AUTO_LETS_ENCRYPT: "yes"
      bunkerweb.USE_REVERSE_PROXY: "yes"
      bunkerweb.REVERSE_PROXY_URL: "/"
      bunkerweb.REVERSE_PROXY_HOST: "http://registry:5000"
      # o protocolo do registry usa PUT/PATCH/DELETE no push
      bunkerweb.ALLOWED_METHODS: "GET|HEAD|POST|PUT|PATCH|DELETE"
      # camadas de imagem passam facil de 1 GB; 0 = sem limite
      bunkerweb.MAX_CLIENT_SIZE: "0"
      # repassa o upload/download em stream em vez de guardar em disco no proxy
      bunkerweb.REVERSE_PROXY_REQUEST_BUFFERING: "no"
      bunkerweb.REVERSE_PROXY_BUFFERING: "no"
      bunkerweb.REVERSE_PROXY_READ_TIMEOUT: "900s"
      bunkerweb.REVERSE_PROXY_SEND_TIMEOUT: "900s"
      # todo push comeca com 401 (desafio de login) e um HEAD 404 por camada
      # que ainda nao existe: o bad behavior baniria o IP do proprio CI
      bunkerweb.USE_BAD_BEHAVIOR: "no"
      # um push faz dezenas de requests por segundo (o padrao e 2r/s)
      bunkerweb.USE_LIMIT_REQ: "no"
      bunkerweb.USE_LIMIT_CONN: "no"
      # corpo binario (camadas) so gera falso positivo no CRS
      bunkerweb.USE_MODSECURITY: "no"
    volumes:
      - registry_data:/var/lib/registry
    networks:
      - proxy_network
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:5000/"]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  proxy_network:
    external: true
    name: proxy_network

volumes:
  registry_data:
    name: registry_data

secrets:
  registry_htpasswd:
    file: "{{secret "registry_htpasswd"}}"
