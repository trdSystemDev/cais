# Daemon do vpsctl: dono do estado e das acoes. A TUI, o CLI e o MCP sao
# clientes dele pelo socket /run/vpsctl/vpsctl.sock.
#
# Instalar:
#   cp vpsctl /usr/local/bin/vpsctl
#   cp vpsctl.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now vpsctl
#
# Pra liberar um usuario sem sudo, crie o grupo (groupadd vpsctl), coloque
# o usuario nele e adicione "--group vpsctl" no ExecStart. Quem esta no
# grupo controla a VPS inteira, igual ao grupo docker.
[Unit]
Description=vpsctl daemon
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vpsctl daemon
Restart=on-failure
RestartSec=2
# cria /run/vpsctl (e apaga ao parar) com permissao so pro root
RuntimeDirectory=vpsctl
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
